# Shared attendance backend (Supabase)
#
# Copy this file to `.env.local` for local development.
# These values are inlined by Vite at build time, so they must also be
# present in the environment that runs `npm run build` before deploying.
#
# Project URL: Supabase Dashboard → Project Settings → API → Project URL
# Anon key:     Supabase Dashboard → Project Settings → API → anon public
#
# The anon key is safe to ship in the browser bundle: it can only call the
# security-definer functions in supabase/schema.sql, not read the tables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
