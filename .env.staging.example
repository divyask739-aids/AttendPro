# Staging-only Supabase configuration template.
# Copy to .env.staging.local and replace these placeholders with the
# separate staging project's values. Never put production values here.
VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-STAGING-ANON-PUBLIC-KEY
VITE_SUPABASE_AUTH_ENABLED=false
